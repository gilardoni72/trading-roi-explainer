# Configuración del Servidor FastAPI
HOST=127.0.0.1
PORT=8000

# Seguridad: Clave API para proteger los endpoints
API_KEY=trading-secret-key-123

# Modo Demostración (True = Offline / Local sin costes; False = Producción con OpenAI real)
